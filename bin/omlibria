#!/usr/bin/env python3
"""Helper for the Omlibria Omarchy plugin.

  omlibria libraries
  omlibria scan <library> <cache-root>
  omlibria prepare <library> <epub-relative-path> <cache-root>
  omlibria chapter <file> <max-image-width> [max-image-height] [fragment]

Every command prints JSON (or HTML for `chapter`) on stdout.
"""
import hashlib
import html
import json
import os
import posixpath
import re
import shutil
import sqlite3
import struct
import sys
import time
import urllib.parse
import xml.etree.ElementTree as ET
import zipfile
from html.parser import HTMLParser

HOME = os.path.expanduser("~")

# A book is untrusted input: it arrives as a zip of attacker-shaped XML, markup
# and file names, and everything below runs inside the desktop shell's process.
MAX_TOTAL_BYTES = 512 * 1024 * 1024   # whole extracted book
MAX_ENTRY_BYTES = 64 * 1024 * 1024    # one file inside it
MAX_ENTRIES = 20000
MAX_XML_BYTES = 16 * 1024 * 1024
MAX_CHAPTER_BYTES = 8 * 1024 * 1024
MAX_SPINE = 20000

# A book's images are handed to the reader's rich-text renderer, which decodes
# them inside the long-lived shell process. A file's own size bounds nothing
# there: a PNG can carry compressed text chunks that expand to far more than
# the file, and its header can claim dimensions no one wants decoded. Images
# are therefore stripped of metadata and bounded before the reader sees them.
MAX_IMAGE_BYTES = 32 * 1024 * 1024    # one image file inside a book
MAX_IMAGE_PIXELS = 12000000           # width x height the renderer will decode
                                      # (the largest image in a real library here is 5.2 MP)
# The reader lays a whole section out as one document and decodes every image
# in it at full size, whatever size it is drawn at. Bounding each image is not
# enough, so a section also has a budget: once its images would hold this much
# decoded memory, or there are this many of them, the rest are left out. The
# heaviest section in a 58-book library holds 18 images and 153 MB.
MAX_CHAPTER_IMAGES = 200
MAX_CHAPTER_IMAGE_BYTES = 256 * 1024 * 1024
# The same goes for the text. Qt lays the section out on the shell's own
# thread, so its cost is the shell's: nested tables double the layout time
# with every level (twenty levels freeze it for half a minute, from a section
# of 661 bytes), deep nesting is quadratic, and plain length is linear. Each is
# bounded at two to three times what the heaviest real section needs
# (0.5 M characters, 66,000 elements, 2,222 table cells, tables one deep).
MAX_CHAPTER_TEXT = 1200000            # characters shown from one section
MAX_CHAPTER_TAGS = 160000             # elements written out for one section
MAX_TABLE_CELLS = 6000
MAX_TABLE_DEPTH = 2                   # a table inside a table inside a table is flattened
MAX_NESTING = 64                      # open elements, wrappers included
MAX_LINK = 2000                       # characters in a link target
MAX_TOC = MAX_SPINE * 2               # table of contents entries kept from one book
MAX_TAG = 4096                        # characters searched for the end of one tag
# Extracted books are kept so reopening one is instant, but a library is
# unbounded and every book opened leaves up to MAX_TOTAL_BYTES behind. Past
# this, the books opened longest ago are removed when another is extracted.
MAX_BOOK_CACHE_BYTES = 2 * 1024 * 1024 * 1024
# Looking for libraries walks the home directory, which can be enormous.
LIBRARY_SEARCH_SECONDS = 5.0
LIBRARY_SEARCH_DIRS = 20000
# Whatever a book or library contains, one run of this helper gets this much
# processor time, wall-clock time and memory, and is stopped at the limit.
HELPER_CPU_SECONDS = {"libraries": 20, "scan": 60, "prepare": 120, "chapter": 30}
HELPER_WALL_SECONDS = 300
HELPER_MEMORY_BYTES = 1536 * 1024 * 1024
MAX_IMAGE_PARTS = 512                 # chunks or segments before a file is refused
MAX_JPEG_SCANS = 64                   # encoders write about ten; each costs a full pass

# Names this reader owns inside a book's extraction directory. A book is a zip
# whose entry names it chooses, so without this it could ship a file that looks
# like one of ours and have it believed.
RESERVED_NAMES = (".extracted", ".omlibria")
# Sanitized images are written beside the extracted book rather than inside it,
# so nothing a book carries can land on one of their names in the first place.
IMAGE_DIR_SUFFIX = ".images"
# The reading order this reader worked out is cached beside the extracted book
# for the same reason, and carries a version so a listing written by an older
# release is rebuilt instead of believed.
META_SUFFIX = ".meta.json"
META_VERSION = 4
# Calibre's cover files come from the same untrusted library as metadata.db, so
# they are sanitized before the shell decodes them, into a directory of this
# reader's own. Books extract into <cache>/<hash>/ and write their sanitized
# images to <cache>/<hash>.images/, so nothing a book unpacks can reach this
# name and nothing but this helper ever writes here.
COVER_DIR = "covers"
# Covers are read on every scan, so one scan spends at most this long turning
# new ones into cached copies. Books past the budget are listed without a
# cover rather than with an unchecked one, and the next scan picks up where
# this one stopped, because everything done already is cached.
COVER_SECONDS = 6.0
# And at most this much disk, counting what earlier scans already cached. A
# library chooses how many books it lists and how big each cover is, so without
# this a shared one could fill the disk a copy at a time.
MAX_COVER_CACHE_BYTES = 256 * 1024 * 1024

# PNG chunks worth keeping: the ones carrying pixels, and fixed-size rendering
# hints. tEXt, zTXt, iTXt, iCCP, eXIf and anything unrecognized are dropped, so
# no attacker-chosen metadata reaches libpng at all.
PNG_KEEP = frozenset((b"IHDR", b"PLTE", b"tRNS", b"IDAT", b"IEND",
                      b"gAMA", b"cHRM", b"sRGB", b"sBIT", b"pHYs"))

# A Calibre library is chosen by the user but its metadata.db may have been
# downloaded or shared, so its size, row counts and text lengths are all
# attacker-chosen. Every one of them is bounded before it reaches memory, and
# the helper refuses a library rather than streaming an unbounded answer into
# the long-lived shell process that reads this output.
MAX_DB_BYTES = 256 * 1024 * 1024      # metadata.db itself
MAX_BOOKS = 20000                     # book rows, and entries in any per-book map
MAX_LINK_ROWS = 200000                # author/series/format rows examined
MAX_AUTHORS_PER_BOOK = 8
MAX_TEXT = 300                        # characters kept from a title, author or series
MAX_PATH_TEXT = 1024                  # characters kept from a stored path or file name
MAX_STDOUT_BYTES = 16 * 1024 * 1024   # anything this helper prints
SCAN_SECONDS = 20.0                   # wall-clock deadline for one library scan
SCAN_PROGRESS_STEPS = 1000            # how often SQLite checks that deadline


class LibraryRefused(Exception):
    """A library exceeded one of the bounds above and was not opened."""


def contained(path, root):
    """`path` resolved, but only if it stays inside `root`; otherwise None.

    Hrefs and file names inside a book are attacker-controlled, so every path
    built from one is checked before it is opened or handed to the reader.
    Resolving symlinks first means a link planted in the cache cannot step out
    either.
    """
    try:
        p = os.path.realpath(path)
        r = os.path.realpath(root)
    except OSError:
        return None
    return p if p == r or p.startswith(r + os.sep) else None


def within(root, rel):
    """`rel` joined onto `root`, or None if it is absolute or climbs out of it.

    Paths in Calibre's metadata.db are only as trustworthy as the library, and a
    library can be downloaded or shared. This is a lexical check on purpose: a
    symlink you made yourself inside your own library is allowed to point out
    of it, but a `../` written into the database is not.
    """
    if not rel or os.path.isabs(rel):
        return None
    base = os.path.normpath(root)
    path = os.path.normpath(os.path.join(base, rel))
    return path if path.startswith(base + os.sep) else None


def book_root(path):
    """The extraction directory holding `path`, or None if it is not in one.

    Returning None rather than falling back to the file's own directory means
    a path from outside any book is refused instead of being rendered.
    """
    d = os.path.dirname(os.path.realpath(path))
    for _ in range(12):
        if os.path.isfile(os.path.join(d, ".extracted")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return None


def write_out(payload):
    """Print one response, or a short refusal if it exceeds the output ceiling.

    Every result this helper produces goes through here, so this is where the
    ceiling is enforced: the reader never has to buffer or parse more than
    MAX_STDOUT_BYTES no matter what a library or book contains.
    """
    if len(payload.encode("utf-8")) > MAX_STDOUT_BYTES:
        payload = "<p>This section is larger than this reader will read.</p>"
    sys.stdout.write(payload)
    sys.stdout.flush()


def out(obj):
    """Print one JSON response, or a short refusal if it would be too large.

    This is the only place the helper writes a result, so it is also the place
    the output ceiling is enforced: the reader never has to buffer or parse
    more than MAX_STDOUT_BYTES no matter what a library or book contains.
    """
    payload = json.dumps(obj)
    size = len(payload.encode("utf-8"))
    if size > MAX_STDOUT_BYTES:
        payload = json.dumps({
            "error": "This library returned more data than this reader will read "
                     "(%d MB)." % (size // (1024 * 1024)),
            "books": [],
        })
    write_out(payload)


# --------------------------------------------------------------------------
# libraries / scan
# --------------------------------------------------------------------------

def libraries():
    found, seen = [], set()

    def consider(path):
        path = os.path.realpath(path)
        if path in seen or not os.path.isfile(os.path.join(path, "metadata.db")):
            return
        seen.add(path)
        found.append(path)

    for name in ("Calibre Library", "Calibre", "calibre", "Books", "Documents/Calibre Library"):
        consider(os.path.join(HOME, name))
    deadline = time.monotonic() + LIBRARY_SEARCH_SECONDS
    for count, (root, dirs, _) in enumerate(os.walk(HOME)):
        if count >= LIBRARY_SEARCH_DIRS or time.monotonic() > deadline:
            break                 # a huge home directory: offer what was found so far
        depth = root[len(HOME):].count(os.sep)
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "venv")]
        if depth >= 3:
            dirs[:] = []
        consider(root)
        if len(found) >= 12:
            break
    out(found)


def bounded(cursor, limit, what):
    """Yield rows, refusing the library if it produces more than `limit` of them.

    Iterating rather than fetching keeps SQLite's own buffer small; the caller
    is responsible for bounding whatever it retains.
    """
    count = 0
    for row in cursor:
        count += 1
        if count > limit:
            cursor.close()
            raise LibraryRefused(
                "This library lists more %s than this reader will open (limit %d)." % (what, limit))
        yield row


def open_library(db):
    """Open metadata.db read-only, with a wall-clock deadline on every query."""
    # No `immutable=1`: that promises SQLite the file cannot change underneath
    # it and lets it skip validation, which is not a promise an untrusted or
    # shared library can keep.
    con = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(db), uri=True)
    con.row_factory = sqlite3.Row
    # The database may not be ours: refuse anything a crafted schema could run.
    con.execute("PRAGMA trusted_schema = OFF")
    con.execute("PRAGMA query_only = ON")
    # A crafted database can make a simple-looking join do unbounded work, so
    # give the whole scan a deadline. Returning non-zero aborts the statement.
    deadline = time.monotonic() + SCAN_SECONDS
    con.set_progress_handler(lambda: 1 if time.monotonic() > deadline else 0, SCAN_PROGRESS_STEPS)
    return con


def scan(library, cache_root):
    db = os.path.join(library, "metadata.db")
    if not os.path.isfile(db):
        out({"error": "No metadata.db in " + library, "books": []})
        return
    size = os.path.getsize(db)
    if size > MAX_DB_BYTES:
        out({"error": "This library's metadata.db is larger than this reader will open "
                      "(%d MB)." % (size // (1024 * 1024)), "books": []})
        return

    con = open_library(db)
    try:
        # Every text column is truncated by SQLite itself, so an oversized
        # title or author name is never materialized in this process at all.
        authors = {}
        for r in bounded(con.execute(
            "SELECT l.book AS book, substr(a.name, 1, ?) AS name FROM books_authors_link l "
            "JOIN authors a ON a.id = l.author ORDER BY l.id", (MAX_TEXT,)),
                MAX_LINK_ROWS, "author entries"):
            names = authors.setdefault(r["book"], [])
            if len(authors) > MAX_BOOKS:
                raise LibraryRefused(
                    "This library lists authors for more than %d books." % MAX_BOOKS)
            if len(names) < MAX_AUTHORS_PER_BOOK:
                names.append((r["name"] or "").replace("|", ","))

        series = {}
        for r in bounded(con.execute(
            "SELECT l.book AS book, substr(s.name, 1, ?) AS name FROM books_series_link l "
            "JOIN series s ON s.id = l.series", (MAX_TEXT,)),
                MAX_LINK_ROWS, "series entries"):
            if len(series) >= MAX_BOOKS and r["book"] not in series:
                raise LibraryRefused(
                    "This library lists series for more than %d books." % MAX_BOOKS)
            series[r["book"]] = r["name"] or ""

        epubs = {}
        for r in bounded(con.execute(
            "SELECT book, substr(name, 1, ?) AS name FROM data WHERE upper(format) = 'EPUB'",
            (MAX_PATH_TEXT,)), MAX_LINK_ROWS, "EPUB entries"):
            if len(epubs) >= MAX_BOOKS and r["book"] not in epubs:
                raise LibraryRefused(
                    "This library lists more than %d EPUBs." % MAX_BOOKS)
            epubs[r["book"]] = r["name"] or ""

        books = []
        cover_deadline = time.monotonic() + COVER_SECONDS
        cover_room = [cover_cache_room(cache_root)]
        for r in bounded(con.execute(
            "SELECT id, substr(title, 1, ?) AS title, substr(sort, 1, ?) AS sort, "
            "substr(path, 1, ?) AS path, has_cover, series_index, "
            "substr(timestamp, 1, 64) AS timestamp FROM books",
            (MAX_TEXT, MAX_TEXT, MAX_PATH_TEXT)), MAX_BOOKS, "books"):
            name = epubs.get(r["id"])
            if not name:
                continue
            rel = posixpath.join(r["path"] or "", name + ".epub")
            epub_path = within(library, rel)
            if not epub_path or not os.path.isfile(epub_path):
                continue          # missing, or the database points outside the library
            # A cover comes from the same untrusted library as the database, so
            # the shell is handed a sanitized copy or nothing at all. Never the
            # library's own file: a crafted one can carry the same compressed
            # metadata a book's images can, and the shelf decodes every cover
            # it shows.
            cover = ""
            if r["has_cover"]:
                raw = within(library, posixpath.join(r["path"] or "", "cover.jpg"))
                if raw and os.path.isfile(raw) and time.monotonic() < cover_deadline:
                    cover = safe_cover(raw, cache_root, cover_room)
            title = r["title"] or ""
            books.append({
                "id": r["id"],
                "key": rel,
                "title": title,
                "sort": (r["sort"] or title).lower(),
                "authors": ", ".join(authors.get(r["id"], [])) or "Unknown",
                "series": series.get(r["id"], ""),
                "seriesIndex": r["series_index"] or 0,
                "cover": cover,
                "added": r["timestamp"] or "",
            })
    except sqlite3.OperationalError as e:
        # The progress handler aborts a statement by returning non-zero, which
        # surfaces here as "interrupted".
        out({"error": "This library took too long to read and was stopped."
                      if "interrupt" in str(e).lower() else "Could not read this library: %s" % e,
             "books": []})
        return
    except LibraryRefused as e:
        out({"error": str(e), "books": []})
        return
    finally:
        con.close()
    out({"error": "", "books": books})


# --------------------------------------------------------------------------
# epub extraction
# --------------------------------------------------------------------------

def local(tag):
    return tag.rsplit("}", 1)[-1]


def read_xml(path):
    with open(path, "rb") as f:
        data = f.read(MAX_XML_BYTES + 1)
    if len(data) > MAX_XML_BYTES:
        raise ValueError("XML file is too large")
    # The check below reads ASCII. UTF-16 and UTF-32 spell the same declaration
    # with a zero byte between every letter and would walk straight past it.
    if b"\x00" in data or data[:2] in (b"\xff\xfe", b"\xfe\xff"):
        raise ValueError("XML must be UTF-8")
    # ElementTree does not fetch external entities, but it will happily expand
    # nested internal ones until the process runs out of memory.
    if re.search(rb"<!DOCTYPE[^>]*\[", data, re.I) or re.search(rb"<!ENTITY", data, re.I):
        raise ValueError("XML entity declarations are not allowed")
    return ET.fromstring(data)


# Markup from a book is scanned with str.find rather than with regular
# expressions of the form `<x[^>]*>.*?</x>`: on input with many openings and no
# closing, each of those restarts its scan at every opening, which is quadratic
# (320 KB of unclosed <body> tags took 38 seconds). Each function below moves
# forward only, so its cost is proportional to the text.

def strip_tags(text, repl):
    """`re.sub(r"<[^>]+>", repl, text)`, in one forward pass."""
    out, pos = [], 0
    while True:
        i = text.find("<", pos)
        if i < 0:
            break
        j = text.find(">", i + 1)
        if j < 0:
            break                 # no '>' after this '<', so none after any later one
        if j == i + 1:            # "<>" is not a tag
            out.append(text[pos:i + 1])
            pos = i + 1
            continue
        out.append(text[pos:i])
        out.append(repl)
        pos = j + 1
    out.append(text[pos:])
    return "".join(out)


def tag_blocks(text, names, ignore_case=True, accept=None):
    """Each `<name ...>inner</name>` in `text`, as (start, end, tag, inner).

    The opening tag may be up to MAX_TAG characters, and if `accept` is given
    it must approve the opening tag's text, or the search moves on one
    character (so `<aside>` does not swallow the `<a>` inside it). Like the
    expression it replaces, a block runs to the first matching close, and
    blocks never overlap.
    """
    low = text.lower() if ignore_case else text
    pos = 0
    while True:
        best = None
        for name in names:
            i = low.find("<" + name, pos)
            if i >= 0 and (best is None or i < best[0]):
                best = (i, name)
        if best is None:
            return
        i, name = best
        j = low.find(">", i + 1 + len(name), i + 2 + len(name) + MAX_TAG)
        if j < 0 or (accept and not accept(text[i:j + 1])):
            pos = i + 1
            continue
        close = "</%s>" % name
        k = low.find(close, j + 1)
        if k < 0:
            # Nothing closes this name from here on. Later openings of the
            # same name cannot close either, so only other names can match.
            names = tuple(n for n in names if n != name)
            if not names:
                return
            pos = i + 1
            continue
        yield i, k + len(close), text[i:j + 1], text[j + 1:k]
        pos = k + len(close)


def without_blocks(text, names):
    """`text` with every block of the given tags removed, replaced by a space."""
    out, pos = [], 0
    for start, end, _, _ in tag_blocks(text, names):
        out.append(text[pos:start])
        out.append(" ")
        pos = end
    out.append(text[pos:])
    return "".join(out)


SELF_CLOSING = re.compile(r"<(div|span|p|a|section)")


def open_self_closing(text):
    """`re.sub(r"<(div|span|p|a|section)([^>]*)/>", r"<\\1\\2></\\1>", text)`, in
    one forward pass: every '<' before the same '>' shares its fate, so each
    stretch is looked at once rather than once per '<' in it."""
    out, pos = [], 0
    while True:
        i = text.find("<", pos)
        if i < 0:
            break
        j = text.find(">", i)
        if j < 0:
            break
        k, m = i, None
        if text[j - 1] == "/":
            while 0 <= k < j:
                m = SELF_CLOSING.match(text, k)
                if m and m.end() <= j - 1:
                    break
                m = None
                k = text.find("<", k + 1, j)
        if m:
            name = m.group(1)
            out.append(text[pos:k])
            out.append("<%s%s></%s>" % (name, text[m.end():j - 1], name))
        else:
            out.append(text[pos:j + 1])
        pos = j + 1
    out.append(text[pos:])
    return "".join(out)


def text_weight(path):
    """Roughly how much reading a spine file holds, for global page estimates."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            raw = f.read(MAX_CHAPTER_BYTES)
    except OSError:
        return 0
    raw = without_blocks(raw, ("script", "style"))
    for _, _, _, inner in tag_blocks(raw, ("body",)):
        raw = inner
        break
    images = len(re.findall(r"(?i)<img\b", raw))
    raw = html.unescape(strip_tags(raw, " "))
    return len(re.sub(r"\s+", " ", raw).strip()) + images * 600


def book_key(rel, epub):
    """The cache directory name for one book: its path, size and mtime."""
    st = os.stat(epub)
    stamp = "%s|%d|%d" % (rel, st.st_size, int(st.st_mtime))
    return hashlib.sha1(stamp.encode()).hexdigest()[:16]


def cached_meta(meta_path, dest):
    """A previously computed reading order, rebuilt from scratch if in doubt.

    Every field the reader goes on to use is checked and copied out by hand, so
    a file that is the wrong version, truncated, the wrong shape, empty, or
    carrying keys this reader never writes (an "error" string, say, which the
    shell would display) is rebuilt rather than trusted.
    """
    try:
        with open(meta_path) as f:
            if os.fstat(f.fileno()).st_size > MAX_XML_BYTES:
                return None
            meta = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(meta, dict) or meta.get("v") != META_VERSION:
        return None
    if meta.get("dir") != dest:
        return None
    spine_in = meta.get("spine")
    toc_in = meta.get("toc")
    if not isinstance(spine_in, list) or not isinstance(toc_in, list):
        return None
    if not spine_in or len(spine_in) > MAX_SPINE or len(toc_in) > MAX_SPINE * 2:
        return None
    spine = []
    for item in spine_in:
        if not isinstance(item, dict):
            return None
        path = item.get("file")
        if not isinstance(path, str) or not contained(path, dest):
            return None
        title = item.get("title")
        chars = item.get("chars")
        if not isinstance(title, str) or not isinstance(chars, int) or isinstance(chars, bool):
            return None
        spine.append({"file": path, "title": title[:MAX_TEXT], "chars": max(0, chars)})
    toc = []
    for entry in toc_in:
        if not isinstance(entry, dict):
            return None
        title = entry.get("title")
        idx = entry.get("spine")
        if not isinstance(title, str) or not isinstance(idx, int) or isinstance(idx, bool):
            return None
        if idx < 0 or idx >= len(spine):
            return None
        toc.append({"title": title[:MAX_TEXT], "spine": idx})
    if not toc:
        return None
    title = meta.get("title")
    return {"v": META_VERSION, "error": "", "dir": dest,
            "title": title[:MAX_TEXT] if isinstance(title, str) else "",
            "spine": spine, "toc": toc}


def tree_bytes(path):
    """Bytes held by the files under `path`, not following links."""
    total = 0
    for root, _, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total


def prune_books(cache_root, keep):
    """Remove the books opened longest ago until the cache is under its ceiling.

    Each extracted book is a directory named by its hash, with its sanitized
    images and its listing beside it. The marker file's time is when the book
    was last opened. `keep` is the book being opened now and is never removed.
    """
    books = []
    try:
        names = os.listdir(cache_root)
    except OSError:
        return
    for name in names:
        path = os.path.join(cache_root, name)
        if len(name) != 16 or not os.path.isdir(path) or os.path.islink(path):
            continue
        try:
            opened = os.stat(os.path.join(path, ".extracted")).st_mtime
        except OSError:
            opened = 0            # never finished: first to go
        size = tree_bytes(path) + tree_bytes(path + IMAGE_DIR_SUFFIX)
        books.append((opened, path, size))
    total = sum(size for _, _, size in books)
    for _, path, size in sorted(books):
        if total <= MAX_BOOK_CACHE_BYTES:
            break
        if path == keep:
            continue
        shutil.rmtree(path, ignore_errors=True)
        shutil.rmtree(path + IMAGE_DIR_SUFFIX, ignore_errors=True)
        try:
            os.unlink(path + META_SUFFIX)
        except OSError:
            pass
        total -= size


def prepare(library, rel, cache_root):
    epub = within(library, rel)
    if not epub or not os.path.isfile(epub):
        out({"error": "That book is not inside the library"})
        return
    dest = os.path.join(cache_root, book_key(rel, epub))
    marker = os.path.join(dest, ".extracted")
    if not os.path.isfile(marker):
        # No marker means no finished extraction, whatever is there: a run
        # stopped part way (at a limit, or by the system) leaves files behind,
        # and they are cleared before trying again.
        shutil.rmtree(dest, ignore_errors=True)
        # Extracted books are the user's private files: keep them private.
        os.makedirs(cache_root, mode=0o700, exist_ok=True)
        os.makedirs(dest, mode=0o700, exist_ok=True)
        # makedirs leaves an existing directory alone, so tighten those made by
        # earlier versions too.
        os.chmod(cache_root, 0o700)
        os.chmod(dest, 0o700)
        try:
            total = 0
            with zipfile.ZipFile(epub) as z:
                for count, m in enumerate(z.infolist()):
                    if count >= MAX_ENTRIES:
                        break
                    if m.is_dir():
                        continue
                    target = contained(os.path.join(dest, m.filename), dest)
                    if not target:
                        continue          # entry tries to escape the cache directory
                    if any(part.startswith(RESERVED_NAMES)
                           for part in os.path.relpath(target, dest).split(os.sep)):
                        continue          # entry claims a name this reader owns
                    os.makedirs(os.path.dirname(target), exist_ok=True)
                    # Copy with a cap on real bytes: a zip header can understate
                    # how much it expands to, so the declared size proves nothing.
                    written = 0
                    with z.open(m) as src, open(target, "wb") as dst:
                        while True:
                            chunk = src.read(65536)
                            if not chunk:
                                break
                            written += len(chunk)
                            total += len(chunk)
                            if written > MAX_ENTRY_BYTES or total > MAX_TOTAL_BYTES:
                                dst.close()
                                os.unlink(target)
                                raise ValueError("Book expands to more than this reader will extract")
                            dst.write(chunk)
        except BaseException:
            # A book that cannot be extracted leaves nothing behind.
            shutil.rmtree(dest, ignore_errors=True)
            raise
        open(marker, "w").close()
        prune_books(cache_root, keep=dest)
    else:
        try:
            os.utime(marker)      # most recently opened, for prune_books()
        except OSError:
            pass

    # Earlier releases kept the sanitized images and the cached reading order
    # inside the extracted book, where the book's own entries could reach them.
    # Anything a pre-upgrade extraction left in those places is discarded: a
    # book opened then may have supplied them itself.
    shutil.rmtree(os.path.join(dest, ".omlibria-images"), ignore_errors=True)
    try:
        os.unlink(os.path.join(dest, ".omlibria-meta.json"))
    except OSError:
        pass

    # The cache directory is keyed by the file's size and mtime, so a cached
    # listing can never be stale for a different book.
    meta_path = dest.rstrip(os.sep) + META_SUFFIX
    meta = cached_meta(meta_path, dest)
    if meta:
        out(meta)
        return

    container = read_xml(os.path.join(dest, "META-INF", "container.xml"))
    opf_rel = None
    for el in container.iter():
        if local(el.tag) == "rootfile":
            opf_rel = el.get("full-path")
            break
    if not opf_rel:
        out({"error": "Not a valid EPUB (no rootfile)"})
        return
    opf_path = contained(os.path.join(dest, opf_rel), dest)
    if not opf_path:
        out({"error": "EPUB points outside itself"})
        return
    opf_dir = posixpath.dirname(opf_rel)
    opf = read_xml(opf_path)

    manifest, title = {}, ""
    spine_ids, ncx_id, nav_href = [], None, None
    for el in opf.iter():
        t = local(el.tag)
        if t == "item":
            manifest[el.get("id")] = {
                "href": el.get("href", ""),
                "type": el.get("media-type", ""),
                "props": el.get("properties", ""),
            }
        elif t == "title" and not title:
            title = (el.text or "").strip()
        elif t == "spine":
            ncx_id = el.get("toc")
        elif t == "itemref":
            if el.get("linear", "yes") != "no":
                spine_ids.append(el.get("idref"))

    def abs_for(href):
        href = urllib.parse.unquote(href.split("#")[0])
        return contained(os.path.join(dest, opf_dir, href), dest)

    spine, by_file = [], {}
    for i, sid in enumerate(spine_ids[:MAX_SPINE]):
        item = manifest.get(sid)
        if not item:
            continue
        path = abs_for(item["href"])
        if not path:
            continue
        by_file[path] = len(spine)
        spine.append({"file": path, "title": ""})
    if not spine:
        out({"error": "EPUB has an empty reading order"})
        return

    toc = []

    def add_toc(label, href):
        idx = by_file.get(abs_for(href))
        label = re.sub(r"\s+", " ", label or "").strip()
        if idx is not None and label:
            toc.append({"title": label, "spine": idx})

    for item in manifest.values():
        if "nav" in item["props"].split():
            nav_href = item["href"]
    if nav_href:
        try:
            nav_path = abs_for(nav_href)
            nav_dir = os.path.dirname(nav_path)   # abs_for returned None if it escaped
            with open(nav_path, encoding="utf-8", errors="replace") as f:
                raw = f.read(MAX_XML_BYTES)
            block = raw
            is_toc = lambda tag: re.search(r"epub:type=[\"'][^\"']*toc[^\"']*[\"']", tag)
            for _, _, tag, inner in tag_blocks(raw, ("nav",), False, is_toc):
                block = tag + inner + "</nav>"
                break
            has_href = lambda tag: re.search(r"href=[\"']([^\"']+)[\"']", tag)
            for _, _, tag, inner in tag_blocks(block, ("a",), False, has_href):
                if len(toc) >= MAX_TOC:
                    break
                found = has_href(tag)
                label = html.unescape(strip_tags(inner, ""))
                href = os.path.normpath(os.path.join(nav_dir, urllib.parse.unquote(found.group(1).split("#")[0])))
                idx = by_file.get(href)
                label = re.sub(r"\s+", " ", label).strip()
                if idx is not None and label:
                    toc.append({"title": label, "spine": idx})
        except Exception:
            toc = []
    if not toc and ncx_id and ncx_id in manifest:
        try:
            ncx_path = abs_for(manifest[ncx_id]["href"])
            ncx_dir = os.path.dirname(ncx_path)
            for el in read_xml(ncx_path).iter():
                if local(el.tag) != "navPoint":
                    continue
                label = ""
                src = ""
                for ch in el:
                    if local(ch.tag) == "navLabel":
                        label = "".join(ch.itertext())
                    elif local(ch.tag) == "content":
                        src = ch.get("src", "")
                href = os.path.normpath(os.path.join(ncx_dir, urllib.parse.unquote(src.split("#")[0])))
                idx = by_file.get(href)
                label = re.sub(r"\s+", " ", label).strip()
                if idx is not None and label:
                    toc.append({"title": label, "spine": idx})
        except Exception:
            toc = []
    if not toc:
        toc = [{"title": "Section %d" % (i + 1), "spine": i} for i in range(len(spine))]
    # Keep the first entry per spine file so "current chapter" lookups stay stable.
    first = {}
    for t in toc:
        first.setdefault(t["spine"], t["title"])
    for idx, label in first.items():
        spine[idx]["title"] = label

    # A spine may list the same file thousands of times; weigh each file once.
    weights = {}
    for item in spine:
        if item["file"] not in weights:
            weights[item["file"]] = text_weight(item["file"])
        item["chars"] = weights[item["file"]]
    toc = toc[:MAX_TOC]

    # Cap the same strings the cached copy is capped at, so reopening a book
    # gives the shell exactly what the first open did.
    for entry in toc:
        entry["title"] = entry["title"][:MAX_TEXT]
    for item in spine:
        item["title"] = item["title"][:MAX_TEXT]
    result = {"v": META_VERSION, "error": "", "dir": dest,
              "title": title[:MAX_TEXT], "spine": spine, "toc": toc}
    try:
        partial = "%s.%d.part" % (meta_path, os.getpid())
        with open(partial, "w") as f:
            json.dump(result, f)
        os.replace(partial, meta_path)
    except OSError:
        pass
    out(result)


# --------------------------------------------------------------------------
# chapter -> Qt rich text
# --------------------------------------------------------------------------

def sanitized_png(data):
    """PNG bytes with every ancillary metadata chunk removed, its size, and how
    many bytes a decoded pixel takes.

    Walking the chunk list and copying only the ones above is what contains the
    expansion: libpng is never handed a compressed text or profile chunk, so
    there is no ratio to get wrong. The header must be the first chunk and the
    only one of its kind, so the size checked here is the size libpng decodes.
    """
    nothing = (None, None, 0)
    parts, dims, pixel, pos, count, ended = [data[:8]], None, 4, 8, 0, False
    while pos + 12 <= len(data):
        length = struct.unpack(">I", data[pos:pos + 4])[0]
        ctype = data[pos + 4:pos + 8]
        end = pos + 12 + length
        if length > MAX_IMAGE_BYTES or end > len(data):
            return nothing
        count += 1
        if count > MAX_IMAGE_PARTS:
            return nothing
        if (ctype == b"IHDR") != (count == 1):
            return nothing          # no header first, or a second one later
        if ctype == b"IHDR":
            if length != 13:
                return nothing
            dims = struct.unpack(">II", data[pos + 8:pos + 16])
            # Sixteen-bit samples decode to a sixteen-bit image: twice the bytes.
            pixel = 8 if data[pos + 16] == 16 else 4
        if ctype in PNG_KEEP:
            parts.append(data[pos:end])
        pos = end
        if ctype == b"IEND":
            ended = True
            break
    if not dims or not ended:
        return nothing
    return b"".join(parts), dims, pixel


# Entropy-coded scan data runs until the next marker that is neither a stuffed
# zero, a restart, nor a fill byte.
JPEG_SCAN_END = re.compile(rb"\xff[^\x00\xd0-\xd7\xff]")


def sanitized_jpeg(data):
    """JPEG bytes with every APPn and comment segment removed, its size, and
    how many bytes a decoded pixel takes.

    The whole file is walked, scans included, rather than copied through from
    the first scan on: a progressive JPEG may carry any number of scans, and
    the decoder makes a full pass over the image for each one, so a few hundred
    kilobytes of repeated scans can hold it busy for minutes. Files with more
    scans than any encoder writes are refused, as are a second frame header
    (the size checked here must be the size that is decoded) and anything after
    the end-of-image marker.
    """
    nothing = (None, None, 0)
    parts, dims, pos, count, scans, ended = [data[:2]], None, 2, 0, 0, False
    size = len(data)
    while pos + 2 <= size:
        if data[pos] != 0xFF:
            return nothing
        marker = data[pos + 1]
        if marker == 0xFF:                      # fill byte before a marker
            pos += 1
            continue
        if marker == 0xD9:                      # end of image
            ended = True
            break
        if marker == 0xD8:
            return nothing                      # a second image inside this one
        if marker == 0x01 or 0xD0 <= marker <= 0xD7:
            pos += 2                            # stray standalone marker: drop it
            continue
        if pos + 4 > size:
            return nothing
        length = struct.unpack(">H", data[pos + 2:pos + 4])[0]
        end = pos + 2 + length
        if length < 2 or end > size:
            return nothing
        count += 1
        if count > MAX_IMAGE_PARTS:
            return nothing
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            if dims or length < 8:
                return nothing                  # two frame headers, or a short one
            height, width = struct.unpack(">HH", data[pos + 5:pos + 9])
            dims = (width, height)
        # APPn carries EXIF, ICC and XMP; COM is a free-text comment.
        if not (0xE0 <= marker <= 0xEF or marker == 0xFE):
            parts.append(data[pos:end])
        pos = end
        if marker == 0xDA:                      # start of scan
            if not dims:
                return nothing                  # a scan before any frame header
            scans += 1
            if scans > MAX_JPEG_SCANS:
                return nothing
            nxt = JPEG_SCAN_END.search(data, pos)
            stop = nxt.start() if nxt else size
            parts.append(data[pos:stop])
            pos = stop
    if not dims or not scans:
        return nothing
    parts.append(b"\xff\xd9")                  # exactly one end marker, nothing after it
    return b"".join(parts), dims, 4


def sanitized_image(path):
    """A metadata-free copy of the image at `path`, or None.

    Returned as (bytes, (w, h), suffix, source size, cost), where cost is the
    memory the decoded image occupies in the shell. Only PNG, JPEG and GIF are
    accepted, by magic bytes rather than by file name. Anything else -- SVG,
    TIFF, WebP, PDF -- would hand a different Qt decoder a parser of its own
    inside the shell, so it is refused rather than sanitized. Every caller that
    hands the shell an image from a book or a library goes through here first.
    """
    try:
        size = os.path.getsize(path)
        if size > MAX_IMAGE_BYTES:
            return None
        with open(path, "rb") as f:
            data = f.read(MAX_IMAGE_BYTES + 1)
    except OSError:
        return None
    if len(data) > MAX_IMAGE_BYTES or len(data) < 16:
        return None

    if data[:8] == b"\x89PNG\r\n\x1a\n":
        clean, dims, pixel = sanitized_png(data)
        suffix = "png"
    elif data[:2] == b"\xff\xd8":
        clean, dims, pixel = sanitized_jpeg(data)
        suffix = "jpg"
    elif data[:6] in (b"GIF87a", b"GIF89a"):
        # GIF has no compressed-metadata path; its extension blocks are plain
        # bytes, and the decoder clips every frame to the canvas declared here,
        # so the size and pixel bounds below are enough.
        clean, dims, pixel, suffix = data, struct.unpack("<HH", data[6:10]), 4, "gif"
    else:
        return None

    if not clean or not dims:
        return None
    width, height = dims
    if not width or not height or width * height > MAX_IMAGE_PIXELS:
        return None
    return clean, dims, suffix, size, width * height * pixel


def write_private(dest, data):
    """Write `data` to `dest` atomically, in a directory only this user reads."""
    try:
        os.makedirs(os.path.dirname(dest), mode=0o700, exist_ok=True)
        partial = "%s.%d.part" % (dest, os.getpid())
        with open(partial, "wb") as f:
            f.write(data)
        os.replace(partial, dest)
    except OSError:
        return False
    return True


def cover_cache_room(cache_root):
    """Bytes of new covers this reader is still willing to cache."""
    used = 0
    try:
        with os.scandir(os.path.join(cache_root, COVER_DIR)) as it:
            for count, entry in enumerate(it):
                if count >= MAX_ENTRIES:
                    return 0
                try:
                    used += entry.stat(follow_symlinks=False).st_size
                except OSError:
                    pass
    except OSError:
        return MAX_COVER_CACHE_BYTES          # nothing cached yet
    return max(0, MAX_COVER_CACHE_BYTES - used)


def safe_cover(path, cache_root, room):
    """Path to a metadata-free copy of a library's cover, or "" if there is none.

    Unlike a book's images, a cover is read on every scan, so the copy is kept
    rather than rewritten each time. That is safe here and not there: a book
    chooses its own entry names and unpacks into the cache, so it could land on
    a computed name inside its extraction directory, while nothing a library
    carries is ever written anywhere -- the library is only read -- and this
    directory is written by this function alone.
    """
    try:
        st = os.stat(path)
    except OSError:
        return ""
    key = hashlib.sha1(
        ("%s|%d|%d" % (path, st.st_size, int(st.st_mtime))).encode()).hexdigest()[:16]
    folder = os.path.join(cache_root, COVER_DIR)
    for suffix in ("png", "jpg", "gif"):
        dest = os.path.join(folder, "%s.%s" % (key, suffix))
        if os.path.isfile(dest):
            return dest
    image = sanitized_image(path)
    if not image:
        return ""           # not an image this reader will hand to a decoder
    clean, suffix = image[0], image[2]
    if len(clean) > room[0]:
        return ""           # the cover cache is full for now
    dest = os.path.join(folder, "%s.%s" % (key, suffix))
    if not write_private(dest, clean):
        return ""
    room[0] -= len(clean)
    return dest


def safe_image(path, root):
    """(path, (w, h), cost) for a metadata-free copy of `path` beside the book."""
    image = sanitized_image(path)
    if not image:
        return None
    clean, dims, suffix, size, cost = image

    # The sanitized bytes are always written, never reused from whatever happens
    # to sit at this path: a book could otherwise ship a file at the name this
    # computes and have it served untouched. Rewriting costs a few milliseconds
    # a chapter, which is far less than converting the chapter itself.
    name = hashlib.sha1(("%s|%d|%d" % (path, size, len(clean))).encode()).hexdigest()[:16]
    folder = root.rstrip(os.sep) + IMAGE_DIR_SUFFIX
    dest = os.path.join(folder, "%s.%s" % (name, suffix))
    if not write_private(dest, clean):
        return None
    return dest, dims, cost


def parse_css(text, rules):
    # Comments, then `selector { body }` pairs, both in one forward pass each.
    parts, pos = [], 0
    while True:
        i = text.find("/*", pos)
        if i < 0:
            break
        j = text.find("*/", i + 2)
        if j < 0:
            break
        parts.append(text[pos:i])
        pos = j + 2
    parts.append(text[pos:])
    text = "".join(parts)
    pos = 0
    while True:
        i = text.find("{", pos)
        if i < 0:
            break
        j = text.find("}", i + 1)
        if j < 0:
            break
        nested = text.find("{", i + 1, j)
        # The selector is the run before this brace with no brace or '@' in it.
        start = max(text.rfind("}", pos, i), text.rfind("@", pos, i), pos - 1) + 1
        if nested >= 0 or start >= i:
            pos = i + 1
            continue
        selector, block = text[start:i], text[i + 1:j]
        pos = j + 1
        props = {}
        for decl in block.split(";"):
            if ":" in decl:
                k, v = decl.split(":", 1)
                props[k.strip().lower()] = v.strip().lower()
        wanted = {}
        if props.get("font-style") in ("italic", "oblique"):
            wanted["i"] = True
        fw = props.get("font-weight", "")
        if fw == "bold" or (fw.isdigit() and int(fw) >= 600):
            wanted["b"] = True
        if props.get("text-align") in ("center", "right", "justify"):
            wanted["align"] = props["text-align"]
        if props.get("text-decoration", "").startswith("underline"):
            wanted["u"] = True
        if not wanted:
            continue
        for sel in selector.split(","):
            sel = sel.strip()
            if re.fullmatch(r"[a-z0-9]*(\.[\w-]+)?", sel, re.I) and sel:
                rules.setdefault(sel.lower(), {}).update(wanted)


SKIP = {"head", "script", "style", "title"}
WRAPPERS = {"div", "section", "article", "figure", "figcaption", "aside", "header", "footer", "nav", "main", "body", "html"}
MARKER = "\u2063"      # invisible separator: marks a link target to land on
LINK_OPEN = "\u2062"   # invisible times: brackets a link so the reader can find it
LINK_CLOSE = "\u2064"  # invisible plus
SENTINELS = (MARKER, LINK_OPEN, LINK_CLOSE)
LINE_SPREAD = 1.4       # slack for the reader's paragraph line-height
TEXT_BLOCKS = {"p", "h1", "h2", "h3", "h4", "h5", "h6", "li", "pre", "td", "th", "blockquote"}
TABLE_PARTS = {"table", "thead", "tbody", "tfoot", "tr", "td", "th"}


class Converter(HTMLParser):
    """Turns XHTML into the small HTML subset Qt's rich text understands."""

    def __init__(self, path, max_w, max_h, rules, fragment=""):
        super().__init__(convert_charrefs=True)
        self.path, self.base = path, os.path.dirname(path)
        self.root = book_root(path)
        self.max_w, self.max_h = max_w, max_h
        self.rules, self.fragment = rules, fragment
        self.marker_due = False   # an invisible marker precedes the next text
        self.o = []
        self.stack = []      # (tag, closing html, is_wrapper)
        self.skip = 0
        self.pre = 0
        self.blk = 0         # depth of explicit text blocks (p, h1, li, ...)
        self.wrap_open = False
        self.last_text = False
        # What this section has cost so far, against the limits at the top.
        self.full = False
        self.text = self.tags = self.cells = self.tables = self.flat = 0
        self.images, self.image_bytes, self.image_note = {}, 0, False

    def finish(self):
        """Close what is open and stop: the section has reached a limit."""
        if self.full:
            return
        for _, close_html, wrapper, _ in reversed(self.stack):
            if not wrapper:
                self.o.append(close_html)
        self.stack = []
        self.close_wrapper()
        self.o.append('<p align="center"><i>This section is longer than Omlibria shows '
                      'at once. The rest of it is not displayed.</i></p>')
        self.full = True

    def styles_for(self, tag, attrs):
        cls = (dict(attrs).get("class") or "").lower().split()
        found = {}
        for key in [tag] + ["." + c for c in cls] + ["%s.%s" % (tag, c) for c in cls]:
            found.update(self.rules.get(key, {}))
        return found

    def close_wrapper(self):
        if self.wrap_open:
            self.o.append("</p>")
            self.wrap_open = False

    def handle_starttag(self, tag, attrs):
        tag = tag.lower()
        if tag in SKIP:
            self.skip += 1
            return
        if self.skip or self.full:
            return
        self.tags += 1
        if self.tags > MAX_CHAPTER_TAGS:
            self.finish()
            return
        a = dict(attrs)
        if self.fragment and self.fragment in (a.get("id"), a.get("name")):
            self.marker_due = True
        if tag in ("img", "image"):
            src = a.get("src") or a.get("xlink:href") or a.get("href")
            if src:
                self.close_wrapper()
                self.emit_image(src)
            return
        if tag == "br":
            self.o.append("<br/>")
            return
        if tag == "hr":
            self.close_wrapper()
            self.o.append("<hr/>")
            return
        if len(self.stack) >= MAX_NESTING:
            return             # deeper than any real book nests: the text still flows
        styles = self.styles_for(tag, attrs)
        name = {"strong": "b", "em": "i"}.get(tag, tag)
        if name in WRAPPERS:
            self.stack.append((tag, "", True, None))
            return
        # Qt's layout time doubles with every level of table nesting, so tables
        # past the second level are flattened: their cells become plain text
        # in the cell that holds them.
        if name in TABLE_PARTS and (self.flat or (name == "table" and self.tables >= MAX_TABLE_DEPTH)):
            self.flat += name == "table"
            self.stack.append((tag, " ", False, "flat" if name == "table" else None))
            return
        kind = None
        if name == "table":
            self.tables += 1
            kind = "table"
        elif name in ("td", "th"):
            self.cells += 1
            if self.cells > MAX_TABLE_CELLS:
                self.finish()
                return
        open_html = close_html = ""
        link = self.link_for(a.get("href")) if name == "a" else None
        if link:
            # A link opening outside any block would otherwise have the lazy
            # paragraph wrapper land inside the anchor.
            if not self.blk and not self.wrap_open:
                self.o.append("<p>")
                self.wrap_open = True
            open_html = '<a href="%s">%s' % (html.escape(link, quote=True), LINK_OPEN)
            close_html = LINK_CLOSE + "</a>"
        elif name in ("b", "i", "u", "sup", "sub", "s", "code", "tt"):
            open_html, close_html = "<%s>" % name, "</%s>" % name
        elif name in ("ul", "ol", "li", "table", "tr", "td", "th", "pre", "blockquote",
                      "h1", "h2", "h3", "h4", "h5", "h6", "p"):
            self.close_wrapper()
            align = styles.get("align")
            attr = ' align="%s"' % align if align and name in ("p", "h1", "h2", "h3", "h4", "h5", "h6") else ""
            open_html, close_html = "<%s%s>" % (name, attr), "</%s>" % name
            if name == "pre":
                self.pre += 1
            if name in TEXT_BLOCKS:
                self.blk += 1
        # inline styling coming from CSS classes
        if styles.get("i"):
            open_html += "<i>"
            close_html = "</i>" + close_html
        if styles.get("b") and not name.startswith("h"):
            open_html += "<b>"
            close_html = "</b>" + close_html
        if styles.get("u"):
            open_html += "<u>"
            close_html = "</u>" + close_html
        self.o.append(open_html)
        self.stack.append((tag, close_html, False, kind))

    def handle_startendtag(self, tag, attrs):
        tag = tag.lower()
        if tag in ("img", "image", "br", "hr"):
            self.handle_starttag(tag, attrs)
        else:
            self.handle_starttag(tag, attrs)
            self.handle_endtag(tag)

    def handle_endtag(self, tag):
        tag = tag.lower()
        if tag in SKIP:
            self.skip = max(0, self.skip - 1)
            return
        if self.skip or self.full:
            return
        for i in range(len(self.stack) - 1, -1, -1):
            if self.stack[i][0] != tag:
                continue
            for t, close_html, wrapper, kind in reversed(self.stack[i:]):
                if wrapper:
                    self.close_wrapper()
                    continue
                self.o.append(close_html)
                if kind == "table":
                    self.tables = max(0, self.tables - 1)
                elif kind == "flat":
                    self.flat = max(0, self.flat - 1)
                if close_html == " ":
                    continue           # a flattened table part: nothing was opened
                if t == "pre":
                    self.pre = max(0, self.pre - 1)
                if t in TEXT_BLOCKS:
                    self.blk = max(0, self.blk - 1)
            del self.stack[i:]
            return

    def handle_data(self, data):
        if self.skip or self.full:
            return
        room = MAX_CHAPTER_TEXT - self.text
        if len(data) > room:
            data = data[:max(0, room)]
            self.text = MAX_CHAPTER_TEXT + 1
        else:
            self.text += len(data)
        for ch in SENTINELS:
            if ch in data:
                data = data.replace(ch, "")   # never let a book's own text look like a sentinel
        if not self.pre:
            data = re.sub(r"\s+", " ", data)
            if not data.strip() and not self.last_text:
                return
        if not data:
            return
        if not self.blk and not self.wrap_open and data.strip():
            # Loose text inside a div: give it its own paragraph.
            self.o.append("<p>")
            self.wrap_open = True
        if self.marker_due and data.strip():
            self.o.append(MARKER)
            self.marker_due = False
        self.o.append(html.escape(data, quote=False))
        self.last_text = True
        if self.text > MAX_CHAPTER_TEXT:
            self.finish()

    def link_for(self, href):
        """Internal links become epub:<abs path>#<fragment>; web links pass through."""
        if not href or len(href) > MAX_LINK:
            return None
        if href.startswith(("http:", "https:")):
            return href
        if ":" in href.split("#")[0]:
            return None  # mailto:, javascript:, ...
        target, _, frag = href.partition("#")
        path = self.path if not target else contained(
            os.path.join(self.base, urllib.parse.unquote(target)), self.root)
        if not path:
            return None        # link points outside the book
        return "epub:" + urllib.parse.quote(path) + ("#" + urllib.parse.quote(frag) if frag else "")

    def emit_image(self, src):
        if src.startswith(("http:", "https:", "data:")):
            return
        path = contained(os.path.join(self.base, urllib.parse.unquote(src.split("#")[0])), self.root)
        if not path or not os.path.isfile(path):
            return             # image source outside the book, or missing
        # Each image is sanitized once per section however often it is used,
        # and counted against the section's budget the first time.
        if path not in self.images:
            got = "over"
            if len(self.images) < MAX_CHAPTER_IMAGES:
                got = safe_image(path, self.root)
                if got and self.image_bytes + got[2] > MAX_CHAPTER_IMAGE_BYTES:
                    got = "over"
                elif got:
                    self.image_bytes += got[2]
            self.images[path] = got
        got = self.images[path]
        if got == "over":
            if not self.image_note:
                self.image_note = True
                self.close_wrapper()
                self.o.append('<p align="center"><i>Some images in this section are not shown: '
                              'it holds more image data than Omlibria loads at once.</i></p>')
            return
        if not got:
            return             # unsupported format, oversized, or malformed
        path, size = got[0], got[1]
        attrs = ""
        # A standalone image goes in its own block. That block is a div rather
        # than a paragraph so the reader's paragraph line-height does not apply
        # to it: the renderer multiplies the whole line box, image included,
        # which would make a full-page image too tall to fit on a page. An
        # image sitting inside a paragraph of text cannot escape that, so it is
        # held to the height that stays within a page once multiplied.
        limit = self.max_h if not self.blk else self.max_h / LINE_SPREAD
        if size and size[0] and size[1]:
            w, h = float(size[0]), float(size[1])
            if w > self.max_w:
                h, w = h * self.max_w / w, float(self.max_w)
            if limit and h > limit:
                w, h = w * limit / h, limit
            attrs = ' width="%d" height="%d"' % (max(1, int(w)), max(1, int(h)))
        elif self.max_w:
            attrs = ' width="%d"' % self.max_w
        img = '<img src="file://%s"%s/>' % (urllib.parse.quote(path), attrs)
        self.o.append(img if self.blk else '<div align="center">%s</div>' % img)
        self.last_text = False


def chapter(path, max_w, max_h=0, fragment=""):
    base = os.path.dirname(path)
    root = book_root(path)
    if not root or not contained(path, root):
        write_out("<p>This section is not part of the book.</p>")
        return
    with open(path, encoding="utf-8", errors="replace") as f:
        raw = f.read(MAX_CHAPTER_BYTES)
    rules = {}
    # Each tag is read once, from its first `<link` to the `>` that ends it.
    sheets, low, pos = [], raw.lower(), 0
    for _ in range(2000):
        i = low.find("<link", pos)
        if i < 0:
            break
        j = low.find(">", i)
        if j < 0:
            break                 # nothing after this point ends a tag
        sheets += re.findall(r"href=[\"']([^\"']+\.css)[\"']", raw[i:j], re.I)
        pos = j + 1
    sheets = sheets[:64]
    for href in sheets:
        css = contained(os.path.join(base, urllib.parse.unquote(href)), root)
        if not css:
            continue           # stylesheet outside the book
        try:
            with open(css, encoding="utf-8", errors="replace") as f:
                parse_css(f.read(MAX_CHAPTER_BYTES), rules)
        except OSError:
            pass
    for _, _, _, inner in tag_blocks(raw, ("style",)):
        parse_css(inner, rules)
    # XHTML self-closing on non-void tags confuses HTMLParser (e.g. <div/>).
    raw = open_self_closing(raw)
    conv = Converter(path, max_w, max_h, rules, fragment)
    conv.feed(raw)
    conv.close()
    body = "".join(conv.o).strip()
    if not re.sub(r"<[^>]+>", "", body).strip() and "<img" not in body:
        body = '<p align="center">&#8226; &#8226; &#8226;</p>'
    write_out(body)


class HelperStopped(Exception):
    """This run reached its processor or wall-clock limit."""


def confine(cmd):
    """Give this run a fixed share of the machine, whatever its input does.

    Markup, stylesheets and databases from a book or a library are parsed
    here, and a crafted one can make a parser do far more work than its size
    suggests. Rather than trust every pattern to be linear, the process as a
    whole is bounded: the soft limits raise a clean refusal, and the hard ones
    stop it outright if it is stuck somewhere that cannot be interrupted.
    """
    import resource
    import signal

    def stop(signum, frame):
        raise HelperStopped("took longer than this reader allows")

    cpu = HELPER_CPU_SECONDS.get(cmd, 30)
    signal.signal(signal.SIGXCPU, stop)
    signal.signal(signal.SIGALRM, stop)
    resource.setrlimit(resource.RLIMIT_CPU, (cpu, cpu + 5))
    resource.setrlimit(resource.RLIMIT_AS, (HELPER_MEMORY_BYTES, HELPER_MEMORY_BYTES))
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    signal.alarm(HELPER_WALL_SECONDS)


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd = argv[1]
    try:
        confine(cmd)
        if cmd == "libraries":
            libraries()
        elif cmd == "scan":
            scan(argv[2], argv[3])
        elif cmd == "prepare":
            prepare(argv[2], argv[3], argv[4])
        elif cmd == "chapter":
            chapter(argv[2], int(float(argv[3])),
                    int(float(argv[4])) if len(argv) > 4 else 0,
                    argv[5] if len(argv) > 5 else "")
        else:
            print(__doc__)
            return 2
    except Exception as e:  # surface to QML instead of a silent empty stdout
        if cmd == "chapter":
            write_out("<p>Could not render this section: %s</p>" % html.escape(str(e)))
        else:
            out({"error": "%s: %s" % (type(e).__name__, e), "books": []})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
